# ==============================================================================
# Giridhari Silks & Jewels - Environment Variables Configuration
# ==============================================================================

# Supabase Database & Auth Configuration
# Obtain from your Supabase Dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay Online Payment Gateway
# Obtain from your Razorpay Dashboard: Settings > API Keys (Use test keys rzp_test_... during development)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=secret_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=webhook_secret_placeholder

# Store Website Deployment URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional Email Provider (Resend, SendGrid, or AWS SES)
EMAIL_PROVIDER_API_KEY=re_placeholder_email_key
